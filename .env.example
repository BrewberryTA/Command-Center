# ============================================================
# COMMAND CENTER — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.
# ============================================================

# --- Firebase ---
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Google Calendar API ---
# Found in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Set the Authorized JavaScript origin to: http://localhost:5173 (dev) and your production domain
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_google_api_key
